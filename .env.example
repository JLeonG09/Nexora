# Variables de docker compose. Copia a `.env` (no se sube) y cambia los valores.

# Obligatorias. AGENT_TOOLS_KEY: mínimo 32 caracteres aleatorios.
# El backend no arranca con una clave corta ni con un valor de ejemplo (cambia-esto, changeme, …).
DB_PASSWORD=<cambia-esto>
AGENT_TOOLS_KEY=<genera-al-menos-32-caracteres-aleatorios>

# Puertos en tu máquina.
FRONTEND_PORT=8081
BACKEND_PORT=8080

# IA: hybrid (reglas + modelo pequeño que solo clasifica) | local (el modelo decide todo, necesita
# uno grande con tool calling, p. ej. qwen2.5:3b) | mock (reglas fijas) | http (servicio propio)
AI_MODE=hybrid
AI_MODEL=qwen2.5:0.5b
# AI_READ_TIMEOUT_MS=30000
# Límites del contenedor `agent` y puerto para medirlo desde tu máquina.
# AGENT_CPUS=4
# AGENT_MEMORY=2g
# AGENT_PORT=11434
# OLLAMA_KEEP_ALIVE=5m
# Obligatoria en compose. Con AI_MODE=http: mínimo 32 caracteres, no un valor de ejemplo.
AI_SERVICE_KEY=<genera-al-menos-32-caracteres-aleatorios>
# Con AI_MODE=http:
# AI_BASE_URL=http://host.docker.internal:8000

# Para el firmante real: SIGNER_MODE=http, SIGNER_SERVICE_KEY igual a la de
# signer/.env y `docker compose --profile signer up --build`.
# Con SIGNER_MODE=http la clave debe tener al menos 32 caracteres.
SIGNER_MODE=mock
SIGNER_SERVICE_KEY=<genera-al-menos-32-caracteres-aleatorios>
# Con SIGNER_MODE=http el backend exige getTransaction(createTxHash) en SUCCESS.
# Vacío = se sigue el modo del firmante. true la fuerza; false la apaga.
# MANDATE_VERIFY_CREATE_TX=

STELLAR_EVENTS_MODE=mock
DEMO_ATTACK_ENABLED=false

# App ID de Privy (el mismo que VITE_PRIVY_APP_ID). El backend valida el access token.
# Obligatorio si SIGNER_MODE o AI_MODE no son mock.
PRIVY_APP_ID=

# Login con Privy en el panel. Vacío = alta sin login. Cambiarlo exige
# reconstruir el frontend. Añade http://localhost:8081 a los orígenes
# permitidos de tu app en el dashboard de Privy.
# VITE_PRIVY_APP_ID=
# VITE_PRIVY_CLIENT_ID=
