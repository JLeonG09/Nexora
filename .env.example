# Variables de docker compose. Copia a `.env` (no se sube) y cambia los valores.

# Obligatorias: con la base en otro contenedor el backend no arranca con valores de ejemplo.
DB_PASSWORD=<cambia-esto>
AGENT_TOOLS_KEY=<cambia-esto>

# Puertos en tu máquina.
FRONTEND_PORT=8081
BACKEND_PORT=8080

# Servicios externos: mock | http
AI_MODE=mock
# AI_BASE_URL=http://host.docker.internal:8000
# AI_SERVICE_KEY=

# Para el firmante real: SIGNER_MODE=http, SIGNER_SERVICE_KEY igual a la de
# signer/.env y `docker compose --profile signer up --build`.
SIGNER_MODE=mock
# SIGNER_SERVICE_KEY=

STELLAR_EVENTS_MODE=mock
DEMO_ATTACK_ENABLED=true

# Login con Privy en el panel. Vacío = alta sin login. Cambiarlo exige
# reconstruir el frontend. Añade http://localhost:8081 a los orígenes
# permitidos de tu app en el dashboard de Privy.
# VITE_PRIVY_APP_ID=
# VITE_PRIVY_CLIENT_ID=
