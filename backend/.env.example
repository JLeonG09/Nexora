SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/nexora
DB_USERNAME=nexora
DB_PASSWORD=<cambia-esto>
CORS_ALLOWED_ORIGINS=http://localhost:5173

# mock | http | local
AI_MODE=mock
AI_BASE_URL=http://localhost:8000
# Con AI_MODE=http: mínimo 32 caracteres y no un valor de ejemplo.
AI_SERVICE_KEY=<clave-de-al-menos-32-caracteres>
AI_CONNECT_TIMEOUT_MS=2000
AI_READ_TIMEOUT_MS=15000
AI_MIN_CONFIDENCE=0.7
# Con AI_MODE=hybrid o local
AI_MODEL=qwen2.5:0.5b

# mock | http
SIGNER_MODE=mock
SIGNER_BASE_URL=http://localhost:3001
# Con SIGNER_MODE=http: mínimo 32 caracteres y no un valor de ejemplo.
SIGNER_SERVICE_KEY=<clave-de-al-menos-32-caracteres>
SIGNER_CONNECT_TIMEOUT_MS=2000
SIGNER_READ_TIMEOUT_MS=45000

# Siempre obligatoria: mínimo 32 caracteres. Corta o de ejemplo (cambia-esto, changeme) y el backend no arranca.
AGENT_TOOLS_KEY=<clave-de-al-menos-32-caracteres>

STELLAR_NETWORK=TESTNET
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# Conciliación on-chain. mock | rpc
STELLAR_EVENTS_MODE=mock
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
JOBS_ENABLED=true
SENT_POLL_INTERVAL_MS=10000
APPROVAL_EXPIRY_INTERVAL_MS=60000
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=60000

APPROVAL_TTL_HOURS=24
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_PROPOSALS_PER_10_MIN=5
DEMO_ATTACK_ENABLED=false

