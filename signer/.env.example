PORT=3001
# 127.0.0.1 por defecto. En Docker se usa 0.0.0.0 (solo red interna).
# HOST=127.0.0.1

# La misma que el backend (SIGNER_SERVICE_KEY). Mínimo 32 caracteres; no uses un valor de ejemplo.
SIGNER_SERVICE_KEY=<clave-de-al-menos-32-caracteres>

# Secreto maestro para derivar las llaves por usuario (§5.6): 32+ bytes aleatorios en base64 o hex.
# Nunca subir, nunca loguear.
AGENT_MASTER_SECRET=<32-bytes-aleatorios-en-base64-no-subir>

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
ACCOUNT_WASM_HASH=1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a
WEBAUTHN_VERIFIER_ADDRESS=CC7EKIHQP3TN4CARQDND6CEOY2UXLWWC2X5GHTD5NLAT7BG5GPZIOM3F
ED25519_VERIFIER_ADDRESS=CAAVTMCBXEIBPR64EAASKFXERVPYFZA2JYP5A3BG6PESWEFUJX5IHKN4

# Quién paga las comisiones (elegir una opción):
CHANNELS_URL=https://channels.openzeppelin.com/testnet
CHANNELS_API_KEY=<no-subir-al-repo>
FEE_PAYER_SECRET=<S...-cuenta-fondeada-con-friendbot-no-subir>
TX_TIMEOUT_SECONDS=60

# Política spending-limit de testnet (la del spike). La regla tiene que incluir
# este contrato; si no, sign-and-submit responde FALLIDO REGLA_SIN_POLITICA.
SPENDING_LIMIT_POLICY=CABXBYJNZ7IUW4G3D6BND5YCAQF3ASSDMDAOKQQ63UYFSO7WUU2TIP5G

# Tope propio del firmante, en USDC (hasta 7 decimales). Por dentro se compara en enteros × 10^7.
# 100 por transacción y 500 cada 24 h: bajo para testnet si se filtra la clave de servicio,
# y por encima del mandato de la demo (25 por pago, 45 al día) para no frenarla.
# Si el monto o el acumulado lo supera, sign-and-submit responde 422 TOPE_FIRMANTE_TX o TOPE_FIRMANTE_PERIODO.
MAX_AMOUNT_PER_TX=100
MAX_AMOUNT_PER_PERIOD=500
PERIOD_HOURS=24
