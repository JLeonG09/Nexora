# ─────────────────────────────────────────────────────────────────────
# Configuracion del frontend. Copia este archivo a `.env` y ajusta.
# Todas las variables empiezan por VITE_ porque Vite solo expone al
# navegador las que lo hacen. Cualquier otra NO llegaria al bundle.
# ─────────────────────────────────────────────────────────────────────

# URL del backend (nexora-backend). Lo normal es dejarla VACIA:
#   - vacia            -> rutas /api relativas (el proxy de Vite las manda
#                        a http://localhost:8080 en desarrollo; nginx en Docker)
#   - http://api...    -> peticiones absolutas; el backend debe permitir CORS
# Para el backend real con la URL vacia, pon VITE_MOCK=false.
# VITE_API_URL=

# Modo mock: `true` = datos de mentira, `false` = backend real.
# Si no lo pones, se deduce solo: mock activo cuando VITE_API_URL esta vacia.
VITE_MOCK=true

# Red de Stellar: `testnet` durante el desarrollo, `public` en produccion.
# Solo afecta a los enlaces del explorador y a la validacion de activos.
VITE_STELLAR_NETWORK=testnet

# Destino del proxy de Vite en desarrollo. Solo se usa si el backend
# NO esta en el puerto 8080.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Login con Privy (https://dashboard.privy.io). Vacio = alta con nombre y
# correo a mano, sin login. El App ID es publico; el App Secret NUNCA va aqui.
# VITE_PRIVY_APP_ID=
# VITE_PRIVY_CLIENT_ID=
